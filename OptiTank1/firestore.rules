rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Profils utilisateurs — lecture/écriture uniquement pour le propriétaire
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Données de prix TCS — lecture publique (non-sensibles)
    // Écriture uniquement via Cloud Function (admin SDK, bypass des règles)
    match /stations_meta/{document} {
      allow read: if true;
      allow write: if false;
    }

    match /price_history/{date} {
      allow read: if true;
      allow write: if false;
    }

    // Config admin — lecture publique, écriture libre (protégée par mdp côté UI)
    match /app_config/{document} {
      allow read: if true;
      allow write: if true;
    }

    // Tokens push — écriture par l'utilisateur connecté, lecture par tout utilisateur connecté
    match /push_tokens/{tokenId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }

  }
}
